{
  "name": "kotoba",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:create": "wrangler d1 create kotoba",
    "db:migrate": "wrangler d1 migrations apply kotoba --local",
    "db:migrate:remote": "wrangler d1 migrations apply kotoba --remote",
    "db:seed": "node scripts/seed-kana.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc shared/normalize.ts shared/queue.ts shared/sql.ts api/srs.ts --outDir .test-build --module esnext --target es2022 --moduleResolution bundler --skipLibCheck",
    "test": "node --test test/",
    "budget": "node scripts/write-budget.mjs",
    "check": "npm run typecheck && npm run test && npm run budget"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "wrangler": "^4.125.0"
  }
}
