{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba",
  "main": "api/index.ts",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotoba",
      "database_id": "52e28231-fb73-435a-858c-e138033d2550"
    }
  ],
  "observability": { "enabled": true }
}
